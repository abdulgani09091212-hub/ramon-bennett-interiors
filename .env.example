# Ramon Bennett Interiors — Production Environment Configuration
# Copy this file to .env.local and fill in your production credentials

# Site URL
NEXT_PUBLIC_SITE_URL=https://www.ramonbennettinteriors.com

# Cal.com Booking Modal Link (e.g. ramonbennett/private-consultation)
NEXT_PUBLIC_CAL_LINK=ramonbennett/private-consultation

# Brevo Transactional Email & CRM
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=atelier@ramonbennettinteriors.com
BREVO_RECIPIENT_EMAIL=atelier@ramonbennettinteriors.com

# Visual Admin Dashboard Access Key
ADMIN_ACCESS_KEY=atelier-bennett-2026

# Google Gemini API (Gemini Omni 1.1 Flash / Veo Video & Image Gen)
GEMINI_API_KEY=your_gemini_api_key_here
